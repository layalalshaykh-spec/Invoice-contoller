generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

enum Role { AP_CLERK AP_MANAGER FINANCE_MANAGER ADMIN AUDITOR }
enum SupplierStatus { ACTIVE INACTIVE PENDING BLOCKED }
enum InvoiceStatus { RECEIVED EXTRACTING VALIDATING MATCHING AUTO_APPROVED EXCEPTION APPROVED REJECTED }

model Organization { id String @id @default(cuid()) name String createdAt DateTime @default(now()) users User[] suppliers Supplier[] purchaseOrders PurchaseOrder[] goodsReceipts GoodsReceiptNote[] invoices Invoice[] rules RulesConfig? }
model User { id String @id @default(cuid()) orgId String name String email String @unique role Role organization Organization @relation(fields:[orgId], references:[id]) exceptions Exception[] auditLogs AuditLog[] }
model Supplier { id String @id @default(cuid()) orgId String name String nameAr String? taxId String? status SupplierStatus bankAccount String? isApproved Boolean @default(true) country String? organization Organization @relation(fields:[orgId], references:[id]) purchaseOrders PurchaseOrder[] invoices Invoice[] @@index([orgId]) }
model PurchaseOrder { id String @id @default(cuid()) orgId String poNumber String supplierId String currency String status String totalAmount Decimal @db.Decimal(18,2) issuedAt DateTime organization Organization @relation(fields:[orgId], references:[id]) supplier Supplier @relation(fields:[supplierId], references:[id]) lines POLine[] goodsReceipts GoodsReceiptNote[] @@unique([orgId,poNumber]) }
model POLine { id String @id @default(cuid()) poId String description String quantity Decimal @db.Decimal(18,3) unitPrice Decimal @db.Decimal(18,2) currency String purchaseOrder PurchaseOrder @relation(fields:[poId], references:[id], onDelete:Cascade) }
model GoodsReceiptNote { id String @id @default(cuid()) orgId String grnNumber String poId String receivedAt DateTime organization Organization @relation(fields:[orgId], references:[id]) purchaseOrder PurchaseOrder @relation(fields:[poId], references:[id]) lines GRNLine[] @@unique([orgId,grnNumber]) }
model GRNLine { id String @id @default(cuid()) grnId String description String quantityRecvd Decimal @db.Decimal(18,3) grn GoodsReceiptNote @relation(fields:[grnId], references:[id], onDelete:Cascade) }
model Invoice { id String @id @default(cuid()) orgId String supplierId String? poNumber String? invoiceNumber String invoiceDate DateTime? dueDate DateTime? currency String? subtotal Decimal? @db.Decimal(18,2) taxAmount Decimal? @db.Decimal(18,2) totalAmount Decimal? @db.Decimal(18,2) sourceFileUrl String sourceLanguage String? rawExtraction Json? status InvoiceStatus duplicateOf String? duplicateStatus String? matchResult Json? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt organization Organization @relation(fields:[orgId], references:[id]) supplier Supplier? @relation(fields:[supplierId], references:[id]) lines InvoiceLine[] exceptions Exception[] auditLogs AuditLog[] @@index([orgId,status]) @@index([supplierId,invoiceNumber]) }
model InvoiceLine { id String @id @default(cuid()) invoiceId String description String quantity Decimal @db.Decimal(18,3) unitPrice Decimal @db.Decimal(18,2) taxAmount Decimal? @db.Decimal(18,2) currency String invoice Invoice @relation(fields:[invoiceId], references:[id], onDelete:Cascade) }
model Exception { id String @id @default(cuid()) invoiceId String category String severity String aiAnalysis String? aiRecommendation String? aiConfidence Float? status String assignedToId String? createdAt DateTime @default(now()) slaDueAt DateTime? invoice Invoice @relation(fields:[invoiceId], references:[id], onDelete:Cascade) assignedTo User? @relation(fields:[assignedToId], references:[id]) @@index([status,severity]) }
model AuditLog { id String @id @default(cuid()) invoiceId String userId String? action String previousStatus String? newStatus String? detail Json? createdAt DateTime @default(now()) invoice Invoice @relation(fields:[invoiceId], references:[id], onDelete:Cascade) user User? @relation(fields:[userId], references:[id]) @@index([invoiceId,createdAt]) }
model RulesConfig { orgId String @id quantityTolerancePercent Float @default(2) priceTolerancePercent Float @default(1) totalTolerancePercent Float @default(1) requireGrn Boolean @default(true) autoApprovalLimit Decimal @default(50000) @db.Decimal(18,2) duplicateDateWindowDays Int @default(30) lowConfidenceThreshold Float @default(0.75) organization Organization @relation(fields:[orgId], references:[id]) }
